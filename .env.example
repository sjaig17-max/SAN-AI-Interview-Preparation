# Application Configuration
APP_NAME="SAN AI Interview Preparation"
ENVIRONMENT=development
PORT=8000

# Database Settings
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/san_ai_db

# Security Settings
# Generate a secret key via: openssl rand -hex 32
SECRET_KEY=supersecretjwtkeythatis64characterslongforenterprisesecurity1234
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Redis Settings
REDIS_URL=redis://localhost:6379/0

# AI Configuration (Supports OpenAI & local API formats like Ollama/vLLM)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1

# Storage (Cloudinary for resume PDFs and profile photo uploads)
CLOUDINARY_URL=cloudinary://key:secret@cloudname

# Firebase & Authentication Config
FIREBASE_PROJECT_ID=san-ai-auth
FIREBASE_PRIVATE_KEY_ID=private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@san-ai-auth.iam.gserviceaccount.com
